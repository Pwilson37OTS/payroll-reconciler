# ---------------------------------------------------------------------------
# Streamlit Community Cloud secrets for the Cost Reconciler.
#
# Paste the filled-in version into:  Manage app -> Settings -> Secrets
# (do NOT commit the filled-in file; this .example is the only one in git).
#
# Differences from local:
#   * require_login = true           (public URL must be gated)
#   * [payroll] root_dir = "data"    (reads the files refresh_data.ps1 commits)
#   * [storage] backend = "snowflake"(durable history; Cloud disk is wiped)
#   * private_key_pem instead of private_key_file (no filesystem on Cloud)
# ---------------------------------------------------------------------------

# Login gate ON for the public URL. Share this password with the team.
require_login = true
app_password  = "CHANGE-ME-to-something-strong"
allowed_emails = [
    "pwil@oaktreestaffing.com",
    # add the colleagues who should have access
]

# Payroll + C2C come from the repo's data/ folder, refreshed by refresh_data.ps1.
[payroll]
root_dir = "data"

# Durable audit history in Snowflake (survives redeploys).
[storage]
backend = "snowflake"
schema  = "BULLHORN_MIRROR.ANALYTICS"

# Bullhorn pull (and the storage backend) use key-pair auth. On Cloud there is no
# key file — paste the PEM inline. Keep private_key_file OUT of this block.
[connections.snowflake]
account   = "OYB76494"
user      = "OAKTREESTAFFING"
role      = "CLAUDEAI"
warehouse = "CLAUDE_WH"
database  = "BULLHORN_MIRROR"
schema    = "ANALYTICS"
private_key_pem = """-----BEGIN PRIVATE KEY-----
MIIE... (paste the full contents of tickler_app_rsa.p8 here, all lines) ...
-----END PRIVATE KEY-----"""

# Optional candidate-id -> entity overrides (rarely needed; Branch is authoritative).
[entity_overrides]
