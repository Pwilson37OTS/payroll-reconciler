# Copy this file to `secrets.toml` for local dev, or paste its contents into
# the app's "Secrets" settings on the host.
# DO NOT commit the real secrets.toml — it is gitignored.

# --- Access ------------------------------------------------------------------
# require_login enforces the login gate. Leave it true (or omit it) for any host
# reachable beyond a tightly restricted network. Set it to false ONLY for an
# internal host whose port is locked to specific machines by firewall (see
# INTERNAL_HOSTING.md) — then access is controlled by the network, not a password.
require_login = true

# Used only when require_login = true.
app_password = "change-me-to-something-strong"
allowed_emails = [
    "pwil@oaktreestaffing.com",
]

# --- Automatic pull: Bullhorn from Snowflake ---------------------------------
# Needed only for the "Pull automatically" data source. Uses Streamlit's native
# connection format. Key-pair auth is recommended (works headless; SSO/MFA do
# not). This is the same block other OakTree Streamlit apps already use.
[connections.snowflake]
account          = "OYB76494"
user             = "OAKTREESTAFFING"
private_key_file = "C:\\Users\\pwil\\.snowflake\\tickler_app_rsa.p8"
role             = "CLAUDEAI"
warehouse        = "CLAUDE_WH"
database         = "BULLHORN_MIRROR"
schema           = "ANALYTICS"

# Password auth alternative (if ever needed) — use EITHER this OR the block above:
# [snowflake]
# account = "..."; user = "..."; password = "..."
# warehouse = "..."; database = "BULLHORN_MIRROR"; role = "..."

# --- Automatic pull: payroll register from SharePoint ------------------------
# Point this at the SharePoint "Payroll Runs" library synced locally (OneDrive)
# or a UNC path. The connector reads the register .xlsx files whose names
# contain the entity code (CTS/OTS) and lets the engine filter by pay date.
[payroll]
root_dir = "C:\\Users\\pwil\\OakTree Software, Inc d b a OakTree Staffing\\Management - PBW Agents\\OakTree Operations\\_shared\\payroll-audit"

# --- Entity overrides (optional) ---------------------------------------------
# Fix Bullhorn PayCycle mislabels: candidate id -> the entity they REALLY belong
# to. Pins which report they appear on, regardless of PayCycle. The lasting fix
# is correcting PayCycle in Bullhorn; remove the entry after the mirror syncs.
[entity_overrides]
# 201524 = "OTS"
